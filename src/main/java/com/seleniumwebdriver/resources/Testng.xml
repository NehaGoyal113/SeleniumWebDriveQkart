<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<suite name="QKart Suite" parallel="none" verbose="1">

    <parameter name="username"              value="testUser"/>
    <parameter name="password"              value="abc@123"/>
    <parameter name="searchProduct"         value="yonex"/>
    <parameter name="invalidProduct"        value="Gesundheit"/>
    <parameter name="productName"           value="Running Shoes"/>
    <parameter name="product1Search"        value="YONEX"/>
    <parameter name="product1Name"          value="YONEX Smash Badminton Racquet"/>
    <parameter name="product2Search"        value="Tan"/>
    <parameter name="product2Name"          value="Tan Leatherette Weekender Duffle"/>
    <parameter name="cartProduct1Search"    value="Xtend"/>
    <parameter name="cartProduct1Name"      value="Xtend Smart Watch"/>
    <parameter name="cartProduct2Search"    value="Yarine"/>
    <parameter name="cartProduct2Name"      value="Yarine Floor Lamp"/>
    <parameter name="expensiveProductSearch" value="Stylecon"/>
    <parameter name="expensiveProductName"  value="Stylecon 9 Seater RHS Sofa Set"/>
    <parameter name="address"               value="Addr line 1 addr Line 2 addr line 3"/>
    <parameter name="contactName"           value="crio user"/>
    <parameter name="contactEmail"          value="criouser@gmail.com"/>
    <parameter name="contactMessage"        value="Testing the contact us page"/>

    <test name="Smoke Tests">
        <groups><run><include name="smoke"/></run></groups>
        <classes>
            <class name="com.seleniumwebdriver.tests.RegisterTest"/>
            <class name="com.seleniumwebdriver.tests.SearchResultTest"/>
            <class name="com.seleniumwebdriver.tests.CartTest"/>
            <class name="com.seleniumwebdriver.tests.UITest"/>
        </classes>
    </test>

    <test name="Regression Tests">
        <groups><run><include name="regression"/></run></groups>
        <classes>
            <class name="com.seleniumwebdriver.tests.SearchResultTest"/>
            <class name="com.seleniumwebdriver.tests.CartTest"/>
            <class name="com.seleniumwebdriver.tests.UITest"/>
        </classes>
    </test>

</suite>